{
    "name": "alexandrfiner/laravel-phpredis-array",
    "description": "laravel-phpredis-array",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandr Morohin",
            "email": "finersanya@gmail.com"
        }
    ],
    "keywords": [
        "laravel-phpredis-array"
    ],
    "homepage": "https://github.com/alexandrfiner/laravel-phpredis-array",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelPhpRedisArray\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelPhpRedisArray\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nunomaduro/collision": "^8.1.1||^7.10.0",
        "orchestra/testbench": "^10.4",
        "phpunit/phpunit": "^11.5",
        "friendsofphp/php-cs-fixer": "^3.94",
        "larastan/larastan": "^3.0"
    },
    "scripts": {
        "phpcs": "php-cs-fixer fix -v --diff --dry-run",
        "style-check": [
            "@phpcs"
        ],
        "phpstan": "phpstan analyse --memory-limit=1G"
    }
}
